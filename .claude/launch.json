{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "windows-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "windows",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "bot-mockup",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "server/bot/mockup"
      ],
      "port": 5180
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "site-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "preview",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "admin-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "server/tools/admin_demo.py",
        "--port",
        "8765"
      ],
      "port": 8765,
      "url": "http://127.0.0.1:8765"
    },
    {
      "name": "design-classic",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5190",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/classic"
      ],
      "port": 5190
    }
  ]
}
