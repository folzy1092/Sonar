{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "windows-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "windows",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "bot-mockup",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "server/bot/mockup"
      ],
      "port": 5180
    }
  ]
}