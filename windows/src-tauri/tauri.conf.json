{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sonar",
  "version": "0.1.1",
  "identifier": "com.folzy.sonar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonar",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#08080a",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --enable-gpu-rasterization --disable-features=HardwareMediaKeyHandling,MediaSessionService,GlobalMediaControls,CalculateNativeWinOcclusion,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Folzy",
    "copyright": "© 2026 Folzy",
    "category": "Music",
    "shortDescription": "Sonar — SoundCloud и Яндекс Музыка в одном плеере",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "template": "installer.nsi"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QzYxRTkxMDBFRjVCNUMKUldSY1crOEFrUjdHU0c1VEVGcGYxVE9qMUlzM1kzZDBDcnA4THJvc3grbWZ2SXlMSVlvK2N2cDcK",
      "endpoints": [
        "https://github.com/folzy1092/Sonar/releases/download/windows-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
