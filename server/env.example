# Sonar server — пример .env (SPEC §3.3).
# Скопируй в server/.env на сервере и заполни. Настоящий .env в git не идёт и в чат не присылается.

# --- Сервер ---
# Порт, который выдал хостинг (Velt даёт один порт, смотри в панели).
PORT=8080
# Адрес, на котором слушает HTTP (админка /admin и API). На хостинге — 0.0.0.0 (deploy/sync.py ставит сам),
# снаружи HTTPS даёт прокси хостинга на домене try-sonar.ru. Локально — 127.0.0.1.
SONAR_HTTP_HOST=127.0.0.1
# Часовой пояс дней в дашборде админки («сегодня» владельца).
SONAR_ADMIN_TZ=Europe/Riga
# Админка: заводской админ folzy создаётся сам при первом запуске, пароль надо сменить при первом входе.
# Забыл пароль — на сервере: python -m sonar.admin passwd  (пароли сюда не пишем).
# Публичный адрес сайта и API (всё на одном сервере).
SONAR_PUBLIC_URL=https://try-sonar.ru
# Ключ шифрования токенов сервисов и токена интеграции (Fernet).
# Сгенерировать один раз:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряешь ключ — сохранённые токены SoundCloud/Яндекса придётся вводить заново.
SONAR_FERNET_KEY=

# --- Telegram-бот @SonarMusicApp ---
# Токен от @BotFather (вида 1234567890:AA...).
SONAR_BOT_TOKEN=
# Твой Telegram ID — админ-команды, подробный /status, принять/отклонить репорт.
SONAR_OWNER_TG_ID=7878830498
# Группа-форум поддержки: одно обращение = одна тема (BOT.md §2.10). Бот — админ с правом
# управлять темами. ID вида -100…; пока группы нет — пусто, «Баг / Идея» выключен.
SUPPORT_GROUP_ID=-1003910646265
# Лог-группа (форум): бот сам создаёт темы «Sonar» и «Sonar · Ошибки». Бот — админ с правом управлять темами.
SONAR_LOG_CHAT_ID=-1002276939424
# Тема «Data» той же группы (общая для бэкапов всех ботов) — t.me/c/2276939424/32139. Ежедневный бэкап базы — только туда.
SONAR_DATA_THREAD_ID=32139

# --- Last.fm (необязательно) ---
# Только для скробблинга: прослушивания в Sonar попадают в твой профиль на last.fm.
# Ключ бесплатный: https://www.last.fm/api/account/create (название — Sonar, callback — пусто).
# Пусто — пункт «Last.fm» в приложении скрыт.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Яндекс Музыка ---
# client_id для входа «в один клик» (публичный, из TZ §4.15).
YANDEX_OAUTH_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d
# Прокси для Яндекса, если с сервера он недоступен (SPEC §3.7а), например socks5://user:pass@host:1080.
YANDEX_PROXY=

# --- Хостинг (deploy/sync.py) ---
# Откуда брать код и какую ветку (по умолчанию folzy1092/Sonar, main).
# SONAR_REPO=folzy1092/Sonar
# SONAR_BRANCH=main
# Токен GitHub (fine-grained, только репо Sonar, Contents: Read-only). Репо публичное — можно оставить пустым;
# нужен, если репо станет приватным или GitHub начнёт отвечать 403 (лимит без токена — 60 запросов в час).
# Создать: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# 1 — перед запуском проверить, пускает ли Яндекс с IP хостинга (нужен YANDEX_TOKEN ниже). Потом выключить.
SONAR_CHECK_YM=0
# Токен Яндекс Музыки y0_… только для этой проверки; после неё строку лучше стереть.
YANDEX_TOKEN=
