---
// /download — тот же блок «Скачать» отдельной страницей: на неё ведут кнопки в приложении и `#ios` с телефона.
import Download from '../../components/home/Download.astro'
import { langParam, langPaths, useT } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
---

<Base lang={lang} path="/download" title={t('Скачать')} description={t('Скачать Sonar для Windows и iPhone.')}>
  <Download lang={lang} headingLevel={1} />
</Base>
