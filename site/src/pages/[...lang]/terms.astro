---
// /terms — юр-документ (SITE.md §5), текст — src/content/legal.ts.
import LegalDoc from '../../components/legal/LegalDoc.astro'
import { LEGAL_DOCS } from '../../content/legal'
import { langParam, langPaths, useT } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
const doc = LEGAL_DOCS.terms
---

<Base lang={lang} path={doc.path} title={t(doc.title)} description={t(doc.description)}>
  <LegalDoc lang={lang} doc={doc} />
</Base>
