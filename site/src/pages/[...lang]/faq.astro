---
// /faq — частые вопросы (SITE.md §5).
import FaqList from '../../components/faq/FaqList.astro'
import { langParam, langPaths, useT } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
---

<Base
  lang={lang}
  path="/faq"
  title={t('Частые вопросы')}
  description={t('Как поставить Sonar на Windows и iPhone, подключить сервисы, оформить Sonar Deep и удалить данные.')}
>
  <div class="wrap page">
    <header class="page__head" data-reveal>
      <h1 class="page__title">{t('Частые вопросы')}</h1>
      <p class="lead">{t('Установка, сервисы, подписка и данные. Не нашёл ответ — спроси в боте.')}</p>
    </header>
    <FaqList lang={lang} />
  </div>
</Base>

<style>
  .page { max-width: calc(820px + var(--gutter) * 2); padding-block: clamp(32px, 6vw, 72px) clamp(56px, 9vw, 112px); }
  .page__head { display: grid; gap: 14px; margin-bottom: clamp(28px, 4vw, 40px); }
  .page__title { font-size: clamp(34px, 5.4vw, 60px); }
</style>
