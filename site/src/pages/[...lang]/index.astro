---
// Главная (SITE.md §3): герой, скриншоты, возможности, Sonar Deep, скачать.
import DeepTeaser from '../../components/home/DeepTeaser.astro'
import Download from '../../components/home/Download.astro'
import Features from '../../components/home/Features.astro'
import Hero from '../../components/home/Hero.astro'
import Shots from '../../components/home/Shots.astro'
import { langParam, langPaths, useT } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
---

<Base
  lang={lang}
  path="/"
  title="Sonar"
  description={t('Музыкальный плеер для Windows и iPhone: SoundCloud, Яндекс Музыка, YouTube Music, VK и Spotify в одном месте, свои лайки и плейлисты, Sonar Mix и тексты песен.')}
>
  <Hero lang={lang} />
  <Shots lang={lang} />
  <Features lang={lang} />
  <DeepTeaser lang={lang} />
  <Download lang={lang} />
</Base>
