---
// 404.html (и /en/404/, /uk/404/, /es/404/ …). На корневую 404 GitHub Pages попадают и `/en/…`, `/de/…` — встроенный
// скрипт переводит их на копию нужного языка, а `notfound.ts` возвращает исходный адрес в строку браузера.
import NotFound from '../../components/notfound/NotFound.astro'
import { langParam, langPaths, useT } from '../../i18n'
import { NOT_FOUND_LANG } from '../../lib/inline-scripts.mjs'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
---

<Base lang={lang} path="/" title={t('Страница не найдена')} description={t('Такой страницы на сайте Sonar нет.')} noindex>
  <script is:inline slot="head" set:html={NOT_FOUND_LANG} />
  <NotFound lang={lang} />
</Base>
