---
// /pay — оформление Sonar Deep (SITE.md §4). Приложение открывает `/pay?plan=&period=&u=`.
import FreeTier from '../../components/pay/FreeTier.astro'
import PayForm from '../../components/pay/PayForm.astro'
import { langParam, langPaths, useT } from '../../i18n'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = langPaths

const lang = langParam(Astro.params.lang)
const { t } = useT(lang)
---

<Base
  lang={lang}
  path="/pay"
  title={t('Оформить Sonar Deep')}
  description={t('Подписка Sonar Deep: тарифы Ping, Echo, Pod и Fleet на 1–4 аккаунта. Платно — только функции Sonar, музыка бесплатна.')}
>
  <div class="wrap page">
    <PayForm lang={lang} />
    <FreeTier lang={lang} />
  </div>
</Base>

<style>
  .page { padding-block: clamp(32px, 6vw, 72px) clamp(56px, 9vw, 112px); }
</style>
