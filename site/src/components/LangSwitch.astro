---
// Флаг языка в шапке, как в приложении. Меню открывается и закрывается кликом (CLAUDE.md), Esc тоже закрывает.
import { LANGS, LANG_NAMES, href, useT, type Lang } from '../i18n'
import Flag from './Flag.astro'
import Icon from './Icon.astro'

interface Props {
  lang: Lang
  /** Путь страницы без языка: `/pay`, `/` … */
  path: string
}

const { lang, path } = Astro.props
const { t } = useT(lang)
---

<div class="lang" data-lang-switch>
  <button class="lang__btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label={t('Язык: {name}', { name: LANG_NAMES[lang] })}>
    <Flag lang={lang} />
    <Icon name="mc:down-line" size={16} class="lang__chev" />
  </button>
  <ul class="lang__menu" role="list">
    {
      LANGS.map((l) => (
        <li>
          <a
            href={href(l, path)}
            hreflang={l}
            lang={l}
            data-lang-link={l}
            aria-current={l === lang ? 'true' : undefined}
          >
            <Flag lang={l} />
            <span>{LANG_NAMES[l]}</span>
            {l === lang && <Icon name="mc:check-line" size={16} class="lang__check" />}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang {
    position: relative;
  }

  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--t) var(--ease),
      border-color var(--t) var(--ease),
      transform var(--t-fast) var(--ease);
  }

  .lang__btn:hover,
  .lang__btn[aria-expanded='true'] {
    background: var(--hover);
    border-color: var(--border);
  }

  .lang__btn:active {
    transform: scale(0.95);
  }

  .lang__btn :global(.lang__chev) {
    color: var(--text-2);
    transition: transform var(--t) var(--ease);
  }

  .lang__btn[aria-expanded='true'] :global(.lang__chev) {
    transform: rotate(180deg);
  }

  .lang__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    min-width: 190px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.8);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top right;
    transition:
      opacity var(--t) var(--ease),
      transform var(--t) var(--ease),
      visibility 0s linear var(--t);
  }

  .lang.is-open .lang__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--t) var(--ease),
      transform var(--t) var(--ease);
  }

  .lang__menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--r-md);
    text-decoration: none;
    font-size: 15px;
    transition: background-color var(--t-fast) var(--ease);
  }

  .lang__menu a:hover {
    background: var(--hover);
  }

  .lang__menu a span {
    flex: 1;
  }

  .lang__menu :global(.lang__check) {
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang__menu {
      transform: none;
    }
  }
</style>

<script>
  import { bindPopover } from '../scripts/popover'

  for (const root of document.querySelectorAll<HTMLElement>('[data-lang-switch]')) {
    const btn = root.querySelector<HTMLButtonElement>('.lang__btn')
    if (btn) bindPopover(root, btn)
  }
</script>
