---
// Скриншоты `#shots` (SITE.md §3.2): карусель листается пальцем (родная прокрутка), мышью — перетаскиванием,
// стрелками и с клавиатуры. Список — `data/shots.json`, только скрины без личных данных.
import data from '../../../data/shots.json'
import { useT, type Lang } from '../../i18n'
import Icon from '../Icon.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useT(lang)
const PLATFORM: Record<string, string> = { windows: 'Windows', ios: 'iPhone' }
---

<section id="shots" class="section shots" aria-labelledby="shots-title">
  <div class="wrap shots__head">
    <div data-reveal>
      <p class="eyebrow">{t('Скриншоты')}</p>
      <h2 id="shots-title" class="h2">{t('Так выглядит Sonar')}</h2>
    </div>
    <div class="shots__nav" data-reveal style="--i: 1">
      <button class="shots__arrow" type="button" data-shots-prev aria-label={t('Предыдущий скриншот')}>
        <Icon name="mc:arrow-right-line" class="flip" />
      </button>
      <button class="shots__arrow" type="button" data-shots-next aria-label={t('Следующий скриншот')}>
        <Icon name="mc:arrow-right-line" />
      </button>
    </div>
  </div>

  <div class="shots__track" data-shots tabindex="0" role="region" aria-roledescription={t('карусель')} aria-label={t('Скриншоты')}>
    {
      data.shots.map((shot, i) => (
        <figure class="shots__slide" data-shot data-reveal style={`--i: ${i}`}>
          <img
            src={shot.src}
            width={shot.width}
            height={shot.height}
            alt={t(shot.alt)}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
          <figcaption>
            <span class="pill">{PLATFORM[shot.platform] ?? shot.platform}</span>
            {t(shot.alt)}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  const DRAG_THRESHOLD = 6

  for (const track of document.querySelectorAll<HTMLElement>('[data-shots]')) {
    const section = track.closest('section')
    const slides = [...track.querySelectorAll<HTMLElement>('[data-shot]')]
    if (!section || slides.length === 0) continue
    const prev = section.querySelector<HTMLButtonElement>('[data-shots-prev]')
    const next = section.querySelector<HTMLButtonElement>('[data-shots-next]')

    const current = () => {
      const left = track.scrollLeft + track.clientWidth / 2
      let best = 0
      slides.forEach((s, i) => {
        const mid = s.offsetLeft + s.offsetWidth / 2
        if (Math.abs(mid - left) < Math.abs(slides[best].offsetLeft + slides[best].offsetWidth / 2 - left)) best = i
      })
      return best
    }

    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))]
      track.scrollTo({ left: target.offsetLeft - (track.clientWidth - target.offsetWidth) / 2, behavior: 'smooth' })
    }

    const sync = () => {
      const i = current()
      slides.forEach((s, j) => s.classList.toggle('is-current', i === j))
      if (prev) prev.disabled = i === 0
      if (next) next.disabled = i === slides.length - 1
    }

    prev?.addEventListener('click', () => go(current() - 1))
    next?.addEventListener('click', () => go(current() + 1))
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true })
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current() - 1)
      else if (e.key === 'ArrowRight') go(current() + 1)
      else return
      e.preventDefault()
    })

    // Мышью — перетаскиванием; палец листает родной прокруткой.
    let startX = 0
    let startScroll = 0
    let dragging = false
    let moved = false
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return
      dragging = true
      moved = false
      startX = e.clientX
      startScroll = track.scrollLeft
    })
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return
      const dx = e.clientX - startX
      if (!moved && Math.abs(dx) < DRAG_THRESHOLD) return
      if (!moved) track.classList.add('is-dragging')
      moved = true
      track.scrollLeft = startScroll - dx
    })
    window.addEventListener('pointerup', () => {
      if (!dragging) return
      dragging = false
      if (!moved) return
      track.classList.remove('is-dragging')
      go(current())
    })
    sync()
  }
</script>

<style>
  .shots__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .shots__head .eyebrow { margin-bottom: 10px; }
  .shots__nav { display: flex; gap: 8px; }
  .shots__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border);
    background: var(--surface-1);
    cursor: pointer;
    transition: background-color var(--t) var(--ease), opacity var(--t) var(--ease), transform var(--t-fast) var(--ease);
  }
  .shots__arrow:hover:not(:disabled) { background: var(--surface-3); }
  .shots__arrow:active:not(:disabled) { transform: scale(0.94); }
  .shots__arrow:disabled { opacity: 0.35; cursor: default; }
  .shots__arrow :global(.flip) { transform: scaleX(-1); }

  .shots__track {
    --side: max(var(--gutter), calc((100vw - var(--wrap)) / 2));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(88vw, 980px);
    gap: clamp(14px, 2vw, 24px);
    padding: 4px var(--side) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--side);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }
  .shots__track::-webkit-scrollbar { display: none; }
  .shots__track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .shots__track.is-dragging img { pointer-events: none; }

  .shots__slide {
    margin: 0;
    scroll-snap-align: center;
    display: grid;
    gap: 14px;
  }
  .shots__slide img {
    width: 100%;
    height: auto;
    border-radius: var(--r-xl);
    border: 1px solid var(--border);
    background: var(--surface-1);
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9);
    transform: scale(0.96);
    opacity: 0.55;
    transition: transform 500ms var(--ease), opacity 500ms var(--ease);
  }
  .shots__slide.is-current img { transform: none; opacity: 1; }
  .shots__slide figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
    font-size: 14px;
    padding-inline: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shots__slide img { transform: none; transition: opacity 300ms linear; }
  }
</style>
