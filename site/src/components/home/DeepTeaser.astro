---
// Блок Sonar Deep на главной (SITE.md §3.4): коротко, без давления — музыка бесплатно, Deep — сверху.
import { href, useT, type Lang } from '../../i18n'
import { PERKS, PLANS, rub } from '../../lib/plans'
import Icon from '../Icon.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useT(lang)

/** Главные плюсы для витрины — по номеру в `plans.json` (полный список — на /pay). */
const TEASER_PERKS = [0, 1, 4, 9, 10].map((i) => PERKS[i]).filter(Boolean)
const fromPrice = Math.min(...PLANS.map((p) => p.monthly))
---

<section class="section deep" aria-labelledby="deep-title">
  <div class="wrap">
    <div class="deep__card card" data-reveal>
      <div class="deep__text">
        <span class="pill pill--deep">
          <Icon name="mc:diamond-line" size={14} />
          Sonar Deep
        </span>
        <h2 id="deep-title" class="h2">{t('Музыка бесплатно. Deep — для тех, кто хочет больше')}</h2>
        <p class="lead">{t('Подписка открывает функции самого Sonar, а не доступ к музыке: слушать, искать, лайкать и скачивать можно и без неё.')}</p>
        <div class="deep__cta">
          <a class="btn btn--primary" href={href(lang, '/pay')}>
            {t('Тарифы')}
            <Icon name="mc:arrow-right-line" />
          </a>
          <span class="muted">{t('от {price} в месяц', { price: rub(fromPrice) })}</span>
        </div>
      </div>
      <ul class="deep__perks" role="list" data-reveal-group>
        {
          TEASER_PERKS.map((perk) => (
            <li data-reveal>
              <span class="deep__check">
                <Icon name="mc:check-line" size={16} />
              </span>
              {t(perk)}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .deep__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(24px, 5vw, 56px);
    overflow: hidden;
    border-color: color-mix(in srgb, var(--deep) 22%, var(--border));
  }
  .deep__text { position: relative; display: grid; gap: 18px; justify-items: start; }
  .deep__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .deep__perks {
    position: relative;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .deep__perks li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--surface-1) 85%, transparent);
    border: 1px solid var(--border);
  }
  .deep__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--deep);
    background: color-mix(in srgb, var(--deep) 14%, transparent);
  }
  @media (max-width: 880px) {
    .deep__card { grid-template-columns: 1fr; }
  }
</style>
