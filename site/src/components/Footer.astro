---
// Подвал (SITE.md §2): канал, бот, «Баг или идея», вопросы, юр-страницы, лицензии, скачивание.
import { LINKS } from '../config'
import { href, useT, type Lang } from '../i18n'
import Icon from './Icon.astro'
import Logo from './Logo.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useT(lang)

const COLUMNS = [
  {
    title: t('Скачать'),
    links: [
      { label: 'Windows', url: LINKS.windowsExe, icon: 'mc:windows-fill' },
      { label: 'iPhone', url: href(lang, '/download#ios'), icon: 'mc:apple-fill' },
      { label: t('Все версии'), url: LINKS.releases, icon: 'mc:github-fill', external: true },
    ],
  },
  {
    title: t('Связь'),
    links: [
      { label: t('Канал'), url: LINKS.channel, icon: 'mc:telegram-fill', external: true },
      { label: t('Бот'), url: LINKS.bot, icon: 'mc:telegram-fill', external: true },
      { label: t('Баг или идея'), url: LINKS.botReport, icon: 'mc:bug-line', external: true },
      { label: t('Вопросы'), url: href(lang, '/faq'), icon: 'mc:question-line' },
      { label: t('Статус'), url: href(lang, '/status'), icon: 'mc:wave-line' },
    ],
  },
  {
    title: t('Документы'),
    links: [
      { label: t('Условия'), url: href(lang, '/terms') },
      { label: t('Конфиденциальность'), url: href(lang, '/privacy') },
      { label: t('Условия подписки'), url: href(lang, '/subscription') },
      { label: t('Удаление данных'), url: href(lang, '/delete') },
      { label: t('Лицензии'), url: href(lang, '/licenses') },
    ],
  },
]
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <a href={href(lang, '/')} class="ftr__logo" aria-label={t('Sonar — на главную')}>
        <Logo size={30} />
        <span>Sonar</span>
      </a>
      <p class="muted">{t('Свой плеер для SoundCloud, Яндекс Музыки, YouTube Music, VK Музыки и Spotify.')}</p>
    </div>
    {
      COLUMNS.map((col) => (
        <nav class="ftr__col" aria-label={col.title}>
          <h2 class="ftr__title">{col.title}</h2>
          <ul role="list">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target={'external' in link && link.external ? '_blank' : undefined}
                  rel={'external' in link && link.external ? 'noopener' : undefined}
                >
                  {'icon' in link && link.icon && <Icon name={link.icon} size={16} />}
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap ftr__bottom">
    <span>© 2026 Sonar</span>
    <span class="muted">{t('Sonar не связан с SoundCloud, Яндексом, YouTube, VK, Spotify и Apple. Названия и знаки принадлежат их владельцам.')}</span>
  </div>
</footer>

<style>
  .ftr {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface-0);
    padding-block: 56px 28px;
    font-size: 15px;
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px 32px;
  }

  .ftr__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
  }

  .ftr__brand p {
    max-width: 34ch;
  }

  .ftr__title {
    font-family: var(--font);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  .ftr__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .ftr__col a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--t) var(--ease), transform var(--t) var(--ease);
  }

  .ftr__col a:hover {
    color: var(--text);
    transform: translateX(2px);
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }

  .ftr__bottom .muted {
    color: var(--text-3);
    max-width: 70ch;
  }

  @media (max-width: 880px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }

    .ftr__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 420px) {
    .ftr__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ftr__col a:hover {
      transform: none;
    }
  }
</style>
