---
// Флаги языков — те же, что в переключателе приложения (windows/src/components/flags.ts, из @iconify-json/flag, MIT).
import type { Lang } from '../i18n'

const FLAGS: Record<Lang, string> = {
  ru: '<path fill="#fff" d="M0 0h640v160H0z"/><path fill="#0039a6" d="M0 160h640v160H0z"/><path fill="#d52b1e" d="M0 320h640v160H0z"/>',
  en: '<path fill="#012169" d="M0 0h640v480H0z"/><path fill="#fff" d="m75 0l244 181L562 0h78v62L400 241l240 178v61h-80L320 301L81 480H0v-60l239-178L0 64V0z"/><path fill="#c8102e" d="m424 281l216 159v40L369 281zm-184 20l6 35L54 480H0zM640 0v3L391 191l2-44L590 0zM0 0l239 176h-60L0 42z"/><path fill="#fff" d="M241 0v480h160V0zM0 160v160h640V160z"/><path fill="#c8102e" d="M0 193v96h640v-96zM273 0v480h96V0z"/>',
  uk: '<g fill-rule="evenodd"><path fill="#0057b8" d="M0 0h640v240H0z"/><path fill="gold" d="M0 240h640v240H0z"/></g>',
}

interface Props {
  lang: Lang
  size?: number
}

const { lang, size = 20 } = Astro.props
---

<svg class="flag" viewBox="0 0 640 480" width={size} height={Math.round((size * 3) / 4)} aria-hidden="true" set:html={FLAGS[lang]} />

<style>
  .flag {
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    flex: none;
  }
</style>
