/* Фразы Siri по-английски (у Siri нет русского). Ключ — русская фраза из SonarShortcuts (App/SonarIntents.swift). */

"Включи Sonar Mix в ${applicationName}" = "Play Sonar Mix in ${applicationName}";
"Sonar Mix в ${applicationName}" = "Sonar Mix in ${applicationName}";
"${applicationName} микс" = "${applicationName} mix";

"Включи любимые в ${applicationName}" = "Play my favorites in ${applicationName}";
"${applicationName} любимые" = "${applicationName} favorites";

"Включи быстрый плейлист в ${applicationName}" = "Play quick playlist in ${applicationName}";
"${applicationName} быстрый плейлист" = "${applicationName} quick playlist";

"Пауза в ${applicationName}" = "Pause ${applicationName}";
"Поставь ${applicationName} на паузу" = "Pause music in ${applicationName}";

"Продолжи ${applicationName}" = "Resume ${applicationName}";
"Играй ${applicationName}" = "Play ${applicationName}";

"Следующий трек в ${applicationName}" = "Next track in ${applicationName}";
"${applicationName} дальше" = "${applicationName} next";
